{
	"name": "@clementprevot/pi-repo-overlay",
	"version": "0.1.0",
	"description": "Pi extension that loads a personal instruction file for the repository a session runs in, matched by its origin URL so every worktree gets it",
	"keywords": [
		"pi-package",
		"pi-extension",
		"agents-md",
		"instructions",
		"context",
		"worktree"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clementprevot/pi-repo-overlay.git"
	},
	"engines": {
		"node": ">=22.6"
	},
	"files": [
		"index.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	}
}
